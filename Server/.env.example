# Copy to .env for local development. Do not commit real secrets.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
MONGO_URI=mongodb://127.0.0.1:27017/subhub247
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-another-long-random-secret
WITHDRAWAL_ENCRYPTION_KEY=replace-with-a-dedicated-random-production-secret
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Demo mode adds clearly-labelled demo funds and simulates VTU delivery; it moves no real money/services.
PAYMENT_MODE=demo
SERVICE_MODE=demo

# Live card top-ups use Paystack. Set PAYMENT_MODE=paystack and provide a secret key.
PAYSTACK_SECRET_KEY=
# Live VTU fulfillment requires the aggregator's documented API endpoint/key and matching contract.
VTU_API_URL=
VTU_API_KEY=
