# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# MongoDB (optional). If unreachable, the API falls back to an embedded
# file store at Server/.data/ automatically. Force with DB_MODE=mongo|file.
MONGO_URI=
DB_MODE=

JWT_SECRET=replace-with-a-long-random-secret

# Leave empty to use the built-in demo gateway (simulated card checkout).
# Set to sk_test_.../sk_live_... to accept real card payments via Paystack.
PAYSTACK_SECRET_KEY=

# true (default) -> new users are verified immediately
# false          -> users must click the emailed verification link
AUTO_VERIFY_EMAIL=true

# Real VTU/bills fulfilment provider (airtime/data/TV/electricity).
# Empty = demo mode: orders complete instantly and successfully.
VTU_PROVIDER_URL=
VTU_PROVIDER_KEY=

# Limits
MIN_DEPOSIT=100
MIN_WITHDRAWAL=500

# Demo account seeded in fallback-store mode only (SEED_DEMO_USER=false to disable)
DEMO_EMAIL=demo@subhub247.com
DEMO_PASSWORD=demo1234
